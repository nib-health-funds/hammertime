{
  "name": "hammertime",
  "version": "5.0.0",
  "description": "U Can't Touch This",
  "main": "hammertime.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "deploy": "serverless deploy --verbose",
    "destroy": "serverless remove --verbose",
    "lint": "eslint --no-error-on-unmatched-pattern *.js",
    "test:unit": "nyc mocha --report lcovonly -- test/**/*.test.js --require test/global.js -R spec",
    "codecov": "codecov",
    "test": "npm run lint && npm run test:unit",
    "test.unit": "npm run test:unit",
    "build": "babel src --out-dir dist"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:nib-health-funds/hammertime.git"
  },
  "author": "nib",
  "license": "MIT",
  "dependencies": {
    "@babel/register": "^7.6.2",
    "aws-sdk": "^2.610.0",
    "luxon": "^1.11.4",
    "moment": "^2.22.1",
    "nyc": "^14.1.1",
    "promise-retry": "^1.1.1",
    "serverless": "^4.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@istanbuljs/nyc-config-babel": "^3.0.0",
    "aws-sdk-mock": "^6.2.2",
    "babel-plugin-istanbul": "^7.0.0",
    "chai": "^3.5.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-chai-expect": "^4.1.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^10.5.0",
    "mocha": "^10.0.0",
    "nyc": "^17.1.0"
  }
}
